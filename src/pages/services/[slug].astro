---
import Base from "../../layouts/Base.astro";
import Container from "../../components/Container.astro";
import Section from "../../components/Section.astro";
import ServiceHeader from "../../components/ServiceHeader.astro";
import MediaHero from "../../components/MediaHero.astro";
import MediaFigure from "../../components/MediaFigure.astro";
import { SERVICES } from "../../data/services";
import { COMPANY } from "../../config";
import { buildBreadcrumbList } from "../../lib/jsonld";

export function getStaticPaths() {
  return SERVICES.map((service, idx) => {
    const prev = SERVICES[(idx - 1 + SERVICES.length) % SERVICES.length];
    const next = SERVICES[(idx + 1) % SERVICES.length];
    return {
      params: { slug: service.slug },
      props: { service, prev, next },
    };
  });
}

const { service, prev, next } = Astro.props;

const totalIndex = String(SERVICES.length).padStart(3, "0");

const GALLERY_INLINE_MAX = 4;

const breadcrumbJsonLd = buildBreadcrumbList([
  { name: "Tangle Tech", item: new URL("/", Astro.site).toString() },
  { name: "Works", item: new URL("/#works", Astro.site).toString() },
  {
    name: `${service.index} ${service.name}`,
    item: new URL(`/services/${service.slug}/`, Astro.site).toString(),
  },
]);

const galleryAll = service.media?.gallery ?? [];
const galleryInline = galleryAll.slice(0, GALLERY_INLINE_MAX);
const galleryHasMore = galleryAll.length > GALLERY_INLINE_MAX;
---

<Base
  title={`${service.name} — ${service.tagline}`}
  description={service.pitch}
  sectionLabel={`TT — § ${service.index} / ${service.name.toUpperCase()}`}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbJsonLd)}
  />

  <!-- ============================================================
       Breadcrumb
       ============================================================ -->
  <section
    class="mx-auto max-w-(--container-page) px-6 pt-12 pb-6 lg:px-10 lg:pt-16"
  >
    <p class="mono flex items-center gap-3 text-(--color-ink-faint)">
      <a href="/" class="accent-link">Tangle Tech</a>
      <span aria-hidden="true">/</span>
      <a href="/#works" class="accent-link">Works</a>
      <span aria-hidden="true">/</span>
      <span class="text-(--color-ink-mid)"
        >§ {service.index} {service.name}</span
      >
    </p>
  </section>

  <!-- ============================================================
       Title block
       ============================================================ -->
  <ServiceHeader service={service} totalIndex={totalIndex} />

  <!-- ============================================================
       Hero image — INK BAND (white screenshots invert against ink ground)
       ============================================================ -->
  {
    service.media?.hero && (
      <section class="bg-(--color-ink) text-(--color-paper)">
        <MediaHero media={service.media.hero} />
      </section>
    )
  }

  <!-- ============================================================
       Pitch (overview)
       ============================================================ -->
  <Section index="A" label="Overview" bordered>
    <p
      class="serif-italic text-2xl leading-[1.55] text-(--color-ink) sm:text-3xl lg:text-4xl"
    >
      {service.pitch}
    </p>
  </Section>

  <!-- ============================================================
       Highlights — numbered editorial entries
       ============================================================ -->
  <Section index="B" label="Features" bordered>
    <ol class="divide-y divide-(--color-rule)">
      {
        service.highlights.map((h, i) => (
          <li class="grid gap-4 py-10 lg:grid-cols-12 lg:gap-6">
            <div class="lg:col-span-2">
              <span class="serif-italic text-3xl text-(--color-accent)">
                {String(i + 1).padStart(2, "0")}.
              </span>
            </div>
            <h3 class="display text-2xl text-(--color-ink) lg:col-span-4 lg:text-3xl">
              {h.title}
            </h3>
            <p class="leading-[1.95] text-(--color-ink-mid) lg:col-span-6">
              {h.body}
            </p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- ============================================================
       Specifications — stack + use cases as specimen sheet
       ============================================================ -->
  <Section index="C" label="Specification" bordered>
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-10">
      <div>
        <p class="mono text-(--color-ink-faint)">— Stack</p>
        <ul class="mt-5 divide-y divide-(--color-rule)">
          {
            service.stack.map(item => (
              <li class="flex items-baseline gap-4 py-3 text-(--color-ink-mid)">
                <span class="mono shrink-0 text-(--color-ink-faint)">─</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="mono text-(--color-ink-faint)">— Use cases</p>
        <ul class="mt-5 divide-y divide-(--color-rule)">
          {
            service.useCases.map(item => (
              <li class="flex items-baseline gap-4 py-3 text-(--color-ink-mid)">
                <span class="mono shrink-0 text-(--color-ink-faint)">─</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <!-- ============================================================
       Gallery — INK BAND (truncated to 4, links to /gallery/<slug>/ if more)
       ============================================================ -->
  {
    galleryAll.length > 0 && (
      <section class="bg-(--color-ink) text-(--color-paper)">
        <Container class="py-20 lg:py-28">
          <div class="grid gap-12 lg:grid-cols-12 lg:gap-6">
            <div class="lg:col-span-3">
              <p class="mono text-(--color-paper)/60">
                <span class="text-(--color-accent)">§</span> D / Plates
              </p>
              {galleryHasMore && (
                <p class="mono mt-3 text-(--color-paper)/40">
                  Showing {GALLERY_INLINE_MAX} of {galleryAll.length}
                </p>
              )}
            </div>
            <div class="grid gap-10 lg:col-span-9 lg:grid-cols-2">
              {galleryInline.map((g, i) => (
                <MediaFigure
                  item={g}
                  plateNum={`PL. ${String(i + 1).padStart(2, "0")}`}
                />
              ))}
            </div>
          </div>

          {galleryHasMore && (
            <div class="mt-16 grid gap-6 border-t border-(--color-paper)/15 pt-10 lg:grid-cols-12">
              <div class="lg:col-span-3" />
              <a
                href={`/gallery/${service.slug}/`}
                class="display group flex items-baseline gap-4 text-2xl text-(--color-paper) no-underline lg:col-span-9 lg:text-4xl"
              >
                <span class="border-b border-(--color-paper)/40 pb-1 transition-colors group-hover:border-(--color-accent) group-hover:text-(--color-accent)">
                  View all {galleryAll.length} plates
                </span>
                <span class="mono text-(--color-paper)/60 transition-transform group-hover:translate-x-1 group-hover:text-(--color-accent)">
                  ─→
                </span>
              </a>
            </div>
          )}
        </Container>
      </section>
    )
  }

  <!-- ============================================================
       CTA
       ============================================================ -->
  <Section index="E" label="Inquiries" bordered>
    <p class="display text-3xl text-(--color-ink) sm:text-5xl lg:text-6xl">
      導入・実証実験・受託、
      <br class="hidden sm:block" />
      お話しましょう。
    </p>
    <a
      href={`mailto:${COMPANY.email}`}
      class="serif-italic mt-10 inline-block text-2xl sm:text-3xl"
    >
      <span class="accent-link">{COMPANY.email}</span>
      <span class="caret"></span>
    </a>
  </Section>

  <!-- ============================================================
       Prev / Next navigation
       ============================================================ -->
  <nav class="border-t border-(--color-rule-strong)">
    <div
      class="mx-auto grid max-w-(--container-page) gap-px bg-(--color-rule) sm:grid-cols-2"
    >
      <a
        href={`/services/${prev.slug}/`}
        class="group block bg-(--color-paper) px-6 py-12 no-underline transition-colors hover:bg-(--color-ink) hover:text-(--color-paper) lg:px-10 lg:py-16"
      >
        <p
          class="mono text-(--color-ink-faint) group-hover:text-(--color-paper)/60"
        >
          ← Prev / § {prev.index}
        </p>
        <p class="display mt-3 text-2xl sm:text-3xl lg:text-4xl">
          {prev.name}
        </p>
        <p
          class="serif-italic mt-2 text-(--color-ink-mid) group-hover:text-(--color-paper)/80"
        >
          {prev.tagline}
        </p>
      </a>
      <a
        href={`/services/${next.slug}/`}
        class="group block bg-(--color-paper) px-6 py-12 text-right no-underline transition-colors hover:bg-(--color-ink) hover:text-(--color-paper) lg:px-10 lg:py-16"
      >
        <p
          class="mono text-(--color-ink-faint) group-hover:text-(--color-paper)/60"
        >
          Next / § {next.index} →
        </p>
        <p class="display mt-3 text-2xl sm:text-3xl lg:text-4xl">
          {next.name}
        </p>
        <p
          class="serif-italic mt-2 text-(--color-ink-mid) group-hover:text-(--color-paper)/80"
        >
          {next.tagline}
        </p>
      </a>
    </div>
  </nav>
</Base>
