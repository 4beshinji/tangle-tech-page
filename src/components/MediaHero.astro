---
import ImageOrImg from "./ImageOrImg.astro";
import type { ServiceMedia } from "@/data/services";

interface Props {
  media: NonNullable<ServiceMedia["hero"]>;
}

const { media } = Astro.props;
const { src, alt, caption, context } = media;
---

<figure class="mx-auto max-w-(--container-page) px-6 py-14 lg:px-10 lg:py-20">
  <p class="mono mb-6 text-(--color-ink-faint)">
    <span class="text-(--color-accent)">§</span> Plate ─ Frontispiece
  </p>
  <ImageOrImg
    src={src}
    alt={alt}
    class="w-full"
    widths={[640, 960, 1280, 1920]}
    sizes="(min-width: 1320px) 1280px, 100vw"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  {
    (caption || context) && (
      <figcaption class="mono mt-5 flex flex-col gap-1 text-(--color-ink-mid) sm:flex-row sm:gap-6">
        {caption && (
          <span>
            <span class="text-(--color-ink-faint)">FIG. ─</span> {caption}
          </span>
        )}
        {context && <span class="text-(--color-ink-faint)">{context}</span>}
      </figcaption>
    )
  }
</figure>
