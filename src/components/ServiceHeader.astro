---
import DisciplineLattice from "./DisciplineLattice.astro";
import type { Service } from "@/data/services";

interface Props {
  service: Service;
  totalIndex: string;
}

const { service, totalIndex } = Astro.props;
const showLatin = service.nameLatin && service.nameLatin !== service.name;
---

<section
  class="mx-auto max-w-(--container-page) px-6 pt-8 pb-20 lg:px-10 lg:pt-16 lg:pb-32"
>
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-6">
    <div class="lg:col-span-2">
      <p class="mono text-(--color-ink-faint)">
        <span class="text-(--color-accent)">§</span>
        {service.index} / {totalIndex}
      </p>
      <p class="mono mt-3 text-(--color-ink-mid)">{service.statusLabel}</p>
    </div>

    <div class="lg:col-span-10">
      <p class="mono text-(--color-ink-mid)">{service.category}</p>
      <h1
        class="display lift mt-4 text-[clamp(3rem,9vw,8rem)] text-(--color-ink)"
      >
        {service.name}
      </h1>
      {
        showLatin && (
          <p class="serif-italic lift mt-3 text-2xl text-(--color-ink-mid) delay-1 sm:text-3xl">
            {service.nameLatin}
          </p>
        )
      }
      <p
        class="serif-italic lift mt-8 max-w-3xl text-2xl text-(--color-ink) delay-2 sm:text-3xl lg:text-4xl"
      >
        {service.tagline}
      </p>

      <div class="lift fade mt-12 border-t border-(--color-rule) pt-6 delay-3">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:gap-10">
          <span class="mono shrink-0 text-(--color-ink-faint)">
            Technology domains
          </span>
          <DisciplineLattice codes={service.disciplines} />
        </div>
      </div>
    </div>
  </div>
</section>
