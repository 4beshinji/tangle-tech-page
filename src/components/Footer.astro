---
import { COMPANY } from "../config";
const year = new Date().getFullYear();
const buildStamp = new Date().toISOString().slice(0, 10).replace(/-/g, ".");
---

<footer class="mt-32 border-t border-(--color-rule)">
  <div
    class="mx-auto grid max-w-(--container-page) gap-12 px-6 py-16 lg:grid-cols-12 lg:gap-6 lg:px-10"
  >
    <div class="lg:col-span-5">
      <p class="mono text-(--color-ink-faint)">§ Index — Tangle Tech</p>
      <p
        class="display mt-4 text-3xl tracking-[-0.025em] text-(--color-ink) sm:text-4xl"
      >
        {COMPANY.tagline}
      </p>
      <p class="mt-4 max-w-md text-sm text-(--color-ink-mid) leading-[1.85]">
        {COMPANY.mission}
      </p>
    </div>

    <div class="lg:col-span-3 lg:col-start-7">
      <p class="mono text-(--color-ink-faint)">Sitemap</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/" class="accent-link">Index</a></li>
        <li><a href="/#practice" class="accent-link">Practice</a></li>
        <li><a href="/#works" class="accent-link">Works</a></li>
        <li><a href="/#about" class="accent-link">About</a></li>
        <li><a href="/#contact" class="accent-link">Contact</a></li>
      </ul>
    </div>

    <div class="lg:col-span-3">
      <p class="mono text-(--color-ink-faint)">Contact</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li>
          <a
            href={`mailto:${COMPANY.email}`}
            class="accent-link"
          >
            {COMPANY.email}
          </a>
        </li>
        <li class="text-(--color-ink-mid)">{COMPANY.domain}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-(--color-rule)">
    <div
      class="mono mx-auto flex max-w-(--container-page) flex-col gap-3 px-6 py-6 text-(--color-ink-faint) sm:flex-row sm:items-center sm:justify-between lg:px-10"
    >
      <span>© {year} {COMPANY.name}. All rights reserved.</span>
      <span>Build {buildStamp} ─ TT/v0.1</span>
    </div>
  </div>
</footer>
