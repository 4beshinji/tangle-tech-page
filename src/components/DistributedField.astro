<style>
  .field-map {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-rule-strong);
    background: var(--color-paper-deep);
    color: var(--color-ink-faint);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .field-map__grid {
    opacity: 0.16;
  }
  .field-map__routes {
    color: var(--color-sky);
    opacity: 0.56;
  }
  .field-map__zone {
    color: var(--color-ink-mid);
    opacity: 0.36;
  }
  .field-map__nodes {
    color: var(--color-accent);
  }
  .field-map__nodes circle:not(.field-map__pulse) {
    fill: currentColor;
  }
  .field-map__nodes text,
  .field-map__readout text {
    fill: var(--color-ink-mid);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
  }
  .field-map__readout text {
    fill: var(--color-ink-faint);
  }
  .field-map__pulse {
    fill: none;
    stroke: currentColor;
    opacity: 0.25;
    transform-box: fill-box;
    transform-origin: center;
    animation: map-pulse 3.4s ease-out infinite;
  }
  .field-map__pulse--2 {
    animation-delay: -1.1s;
  }
  .field-map__pulse--3 {
    animation-delay: -2.2s;
  }
  @keyframes map-pulse {
    0% {
      opacity: 0.6;
      transform: scale(0.35);
    }
    75%,
    100% {
      opacity: 0;
      transform: scale(1.35);
    }
  }
</style>
