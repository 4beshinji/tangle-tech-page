---
import { Image } from "astro:assets";
import { isImageMetadata } from "@/data/services";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: "eager" | "lazy" | null | undefined;
  fetchpriority?: "high" | "low" | "auto" | null | undefined;
  decoding?: "async" | "auto" | "sync" | null | undefined;
}

const {
  src,
  alt,
  class: className,
  widths,
  sizes,
  loading,
  fetchpriority,
  decoding,
} = Astro.props;
---

{
  isImageMetadata(src) ? (
    <Image
      src={src}
      alt={alt}
      class={className}
      widths={widths}
      sizes={sizes}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
    />
  ) : (
    <img
      src={src}
      alt={alt}
      class={className}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
    />
  )
}
